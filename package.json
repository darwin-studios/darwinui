{
  "name": "darwinui-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "node scripts/catalog-sources.mjs && pnpm -r --if-present build",
    "check-types": "pnpm -r --if-present check-types",
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "test:consumers": "node scripts/test-consumers.mjs",
    "test:e2e": "playwright test",
    "audit:public": "node scripts/audit-public.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@playwright/test": "1.56.1",
    "@axe-core/playwright": "4.11.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "vite": "6.3.5",
    "tsx": "4.20.6",
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@modelcontextprotocol/client": "2.0.0",
    "prettier": "3.6.2"
  }
}
