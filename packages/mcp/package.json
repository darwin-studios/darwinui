{
  "name": "@darwinui/mcp",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/darwin-studios/darwinui.git",
    "directory": "packages/mcp"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "development": "./src/client/index.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "development": "./src/server/index.ts",
      "default": "./dist/server/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "development": "./src/build/index.ts",
      "default": "./dist/build/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node ../../scripts/build-library.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@darwinui/core": "workspace:*",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "vite": "6.3.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
