{
  "name": "@darwinui/react",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/darwin-studios/darwinui.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.tsx",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node ../../scripts/build-library.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@darwinui/core": "workspace:*",
    "@radix-ui/react-slot": "1.2.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
